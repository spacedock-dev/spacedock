diff --git a/internal/dispatch/build_merged_mode_test.go b/internal/dispatch/build_merged_mode_test.go
index 13c9d9560..d897686dc 100644
--- a/internal/dispatch/build_merged_mode_test.go
+++ b/internal/dispatch/build_merged_mode_test.go
@@ -4,7 +4,9 @@ package dispatch
 
 import (
 	"encoding/json"
+	"os"
 	"path/filepath"
+	"regexp"
 	"strings"
 	"testing"
 )
@@ -61,30 +63,83 @@ func TestBuildMergedModeEmission(t *testing.T) {
 	}
 }
 
-// TestBuildMergedModeCompletionSignal is AC-6's fixture: the merged dispatch
-// body carries the completion-signal block pinned to the single worker→lead
-// target "team-lead" (matching the ensign runtime), not "main", and not absent.
+// TestBuildMergedModeCompletionSignal replays the successful native handoff from
+// CI35355801918 separate-review-required, including the failed recipient first.
 func TestBuildMergedModeCompletionSignal(t *testing.T) {
-	home := t.TempDir()
-	t.Setenv("HOME", home)
-	root := t.TempDir()
-	stdinArgs := mergedBuildArgs(t, root, "backlog")
-	stdin := "- a"
-
-	native := runNative(stdin, stdinArgs...)
+	t.Setenv("HOME", t.TempDir())
+	native := runNative("- a", mergedBuildArgs(t, t.TempDir(), "backlog")...)
 	if native.exit != 0 {
-		t.Fatalf("merged build exit=%d, want 0\nstderr:\n%s", native.exit, native.stderr)
+		t.Fatal(native.stderr)
 	}
 	body := readDispatchBody(t, dispatchFilePathFromStdout(t, native.stdout))
-
-	if !strings.Contains(body, "### Completion Signal") {
-		t.Fatalf("merged dispatch body must carry a completion-signal block (the worker→lead signal):\n%s", body)
-	}
-	if !strings.Contains(body, `SendMessage(to="team-lead"`) {
-		t.Errorf("merged completion signal must target the pinned single reply name \"team-lead\":\n%s", body)
-	}
-	if strings.Contains(body, `SendMessage(to="main"`) {
-		t.Errorf("merged completion signal must pin ONE target — \"main\" must not appear alongside \"team-lead\":\n%s", body)
+	call := regexp.MustCompile(`SendMessage\(to="([^"]+)", message="Done:`).FindStringSubmatch(body)
+	if len(call) != 2 {
+		t.Fatal("missing completion call")
+	}
+	capture, err := os.ReadFile("testdata/claude-completion-route.jsonl")
+	if err != nil {
+		t.Fatal(err)
+	}
+	recipients := map[string]string{}
+	parents := map[string]string{}
+	delivered := map[string]bool{}
+	completed := map[string]bool{}
+	for _, line := range strings.Split(string(capture), "\n") {
+		if line == "" {
+			continue
+		}
+		var e struct {
+			Parent  string `json:"parent_tool_use_id"`
+			Type    string `json:"type"`
+			Subtype string `json:"subtype"`
+			Status  string `json:"status"`
+			ToolID  string `json:"tool_use_id"`
+			Message struct {
+				Content []struct {
+					ID     string `json:"id"`
+					ToolID string `json:"tool_use_id"`
+					Name   string `json:"name"`
+					Input  struct {
+						To string `json:"to"`
+					} `json:"input"`
+					Content []struct {
+						Text string `json:"text"`
+					} `json:"content"`
+				} `json:"content"`
+			} `json:"message"`
+		}
+		if err := json.Unmarshal([]byte(line), &e); err != nil {
+			t.Fatal(err)
+		}
+		for _, block := range e.Message.Content {
+			if block.Name == "SendMessage" {
+				recipients[block.ID], parents[block.ID] = block.Input.To, e.Parent
+			}
+			for _, content := range block.Content {
+				var result struct {
+					Success bool `json:"success"`
+				}
+				if err := json.Unmarshal([]byte(content.Text), &result); err != nil {
+					t.Fatal(err)
+				}
+				if result.Success && parents[block.ToolID] == e.Parent && e.Parent != "" {
+					delivered[recipients[block.ToolID]] = true
+				}
+			}
+		}
+		if e.Type == "system" && e.Subtype == "task_notification" && e.Status == "completed" {
+			for id, parent := range parents {
+				if parent == e.ToolID {
+					completed[recipients[id]] = true
+				}
+			}
+		}
+	}
+	if delivered["team-lead"] {
+		t.Fatal("captured unreachable recipient counted as delivered")
+	}
+	if !delivered[call[1]] || !completed[call[1]] {
+		t.Fatalf("generated recipient %q has no successful captured delivery and parent completion", call[1])
 	}
 }
 
