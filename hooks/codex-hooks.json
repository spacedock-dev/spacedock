{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=${PLUGIN_ROOT:-}; [ -n \"$root\" ] || exit 0; \"$root/scripts/codex-bridge-events.sh\" >/dev/null 2>&1 || true'"
          }
        ]
      }
    ],
