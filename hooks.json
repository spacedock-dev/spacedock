{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/codex_session_start_compact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/codex_post_compact_notice.sh"
          }
        ]
      }
    ]
  }
}
