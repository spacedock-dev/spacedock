+			}
+			after, err := os.ReadFile(entity)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(after) != string(before) {
+				t.Fatalf("away mutation changed entity bytes\n--- before ---\n%s\n--- after ---\n%s", before, after)
